# Copy to .env.dev for local development (values below work as-is),
# or to .env.prod on the server (change everything marked PROD).
SECRET_KEY=dev-only-change-me          # PROD: long random string
DEBUG=True                             # PROD: False
ALLOWED_HOSTS=localhost,127.0.0.1      # PROD: johnpennyman.com,www.johnpennyman.com
ADMIN_URL=admin                        # PROD: a non-obvious path
DOMAIN=localhost                       # PROD: johnpennyman.com
POSTGRES_DB=movies_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres             # PROD: long random string
DB_HOST=db
DB_PORT=5432
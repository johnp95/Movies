# DOMAIN=localhost uses Caddy's local CA; a real domain gets a Let's Encrypt cert
# One canonical host: www gets its own cert and redirects to the bare domain
www.{$DOMAIN:localhost} {
	redir https://{$DOMAIN:localhost}{uri} permanent
}

{$DOMAIN:localhost} {
	encode zstd gzip

	# Django only sets HSTS on its own responses, so set it here for the SPA too
	header Strict-Transport-Security "max-age=31536000"

	# Django: API, DRF login, admin, and its WhiteNoise-served static files
	@django path /api/* /api-auth/* /static/* /{$ADMIN_URL:admin}*
	handle @django {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv

		# Hashed Vite assets never change, so let browsers cache them forever
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# SPA fallback so react-router routes survive a page refresh
		try_files {path} /index.html
		file_server
	}
}

:80 {
	root * /srv
	encode zstd gzip

	# Hashed Vite assets never change, so let browsers cache them forever
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# SPA fallback so react-router routes survive a page refresh
	try_files {path} /index.html
	file_server
}
